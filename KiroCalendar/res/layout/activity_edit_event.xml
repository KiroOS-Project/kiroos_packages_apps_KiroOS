<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btn_cancel"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@android:string/cancel"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_close" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:text="@string/save"
            android:textColor="@color/kiro_on_accent"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp">

            <EditText
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/title_hint"
                android:inputType="textCapSentences"
                android:textSize="20sp"
                style="@style/Kiro.Field" />

            <Switch
                android:id="@+id/all_day"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kiro_touch_target"
                android:paddingEnd="4dp"
                android:paddingStart="4dp"
                android:text="@string/all_day"
                style="@style/Kiro.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/start_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/PickerField" />

                <TextView
                    android:id="@+id/start_time"
                    android:layout_width="104dp"
                    android:layout_marginStart="8dp"
                    style="@style/PickerField" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/end_date"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    style="@style/PickerField" />

                <TextView
                    android:id="@+id/end_time"
                    android:layout_width="104dp"
                    android:layout_marginStart="8dp"
                    style="@style/PickerField" />
            </LinearLayout>

            <TextView android:text="@string/repeat" style="@style/FieldLabel" />

            <Spinner
                android:id="@+id/repeat"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kiro_touch_target" />

            <TextView android:text="@string/reminder" style="@style/FieldLabel" />

            <Spinner
                android:id="@+id/reminder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kiro_touch_target" />

            <TextView android:text="@string/calendar" style="@style/FieldLabel" />

            <Spinner
                android:id="@+id/calendar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/kiro_touch_target" />

            <EditText
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/location_hint"
                android:inputType="textPostalAddress"
                style="@style/Kiro.Field" />

            <EditText
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="top"
                android:hint="@string/description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                style="@style/Kiro.Field" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
