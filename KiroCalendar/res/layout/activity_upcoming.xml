<?xml version="1.0" encoding="utf-8"?>
<!-- Kiro Calendar 1.2: upcoming events and search -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="?android:attr/textColorPrimary" />

        <TextView
            style="@style/Kiro.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/upcoming" />
    </LinearLayout>

    <EditText
        android:id="@+id/search"
        style="@style/Kiro.Field"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:drawableTint="@color/kiro_text_tertiary"
        android:hint="@string/search_events"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:singleLine="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/empty"
            style="@style/Kiro.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
