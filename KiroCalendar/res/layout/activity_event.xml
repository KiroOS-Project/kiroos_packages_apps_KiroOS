<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/back"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_edit"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/edit"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/delete"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="24dp"
            android:paddingStart="24dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Kiro.Title" />

            <TextView
                android:id="@+id/when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/kiro_text_secondary"
                style="@style/Kiro.Body" />

            <LinearLayout android:id="@+id/row_repeat" style="@style/DetailRow">
                <ImageView android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_repeat" style="@style/DetailIcon" />
                <TextView android:id="@+id/repeat" style="@style/DetailText" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_location" style="@style/DetailRow"
                android:background="@drawable/kiro_row">
                <ImageView android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_place" style="@style/DetailIcon" />
                <TextView android:id="@+id/location" style="@style/DetailText" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_reminder" style="@style/DetailRow">
                <ImageView android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_alarm" style="@style/DetailIcon" />
                <TextView android:id="@+id/reminder" style="@style/DetailText" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_calendar" style="@style/DetailRow">
                <ImageView android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_event" style="@style/DetailIcon" />
                <TextView android:id="@+id/calendar" style="@style/DetailText" />
            </LinearLayout>

            <LinearLayout android:id="@+id/row_description" style="@style/DetailRow">
                <ImageView android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_info" style="@style/DetailIcon" />
                <TextView android:id="@+id/description" android:autoLink="web|email|phone"
                    style="@style/DetailText" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
