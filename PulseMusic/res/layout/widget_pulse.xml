<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse widget: the album art, the song, previous / play-pause / next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pulse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pulse_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/pulse_art"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/widget_pulse_art_bg"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pulse_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:textColor="@color/kiro_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pulse_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/kiro_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/pulse_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/previous"
                android:padding="9dp"
                android:src="@drawable/ic_previous"
                android:tint="@color/kiro_text" />

            <ImageView
                android:id="@+id/pulse_toggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_pulse_play_bg"
                android:contentDescription="@string/play"
                android:padding="11dp"
                android:src="@drawable/ic_play"
                android:tint="@color/kiro_on_accent" />

            <ImageView
                android:id="@+id/pulse_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/next"
                android:padding="9dp"
                android:src="@drawable/ic_next"
                android:tint="@color/kiro_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
