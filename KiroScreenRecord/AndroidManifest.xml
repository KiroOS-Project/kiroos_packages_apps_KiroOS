<?xml version="1.0" encoding="utf-8"?>
<!-- Screen Recorder 1.0 (KiroOS Beta 3): records the screen at 1080p 60 fps (or 720p 30 fps) with
     the device audio or the microphone, from its control center tile only (no app icon; SystemUI's
     AutoTileManager adds the tile once). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kiroos.screenrecord"
    android:versionCode="101"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the device audio: the remote submix input, and its output connected while recording -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- "Show touches" while recording -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_screenrecord"
        android:theme="@style/Theme.Kiro"
        android:supportsRtl="true">

        <activity
            android:name=".StartActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.ScreenRecord.Start"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:exported="false" />

        <service
            android:name=".RecordService"
            android:exported="false" />

        <service
            android:name=".RecordTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_qs_screenrecord"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
