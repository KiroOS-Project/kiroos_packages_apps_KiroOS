<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            style="@style/Kiro.Title" />

        <!-- 1.2: recording quality -->
        <TextView
            android:id="@+id/quality"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/kiro_chip"
            android:gravity="center"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:textColor="@color/kiro_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:textColor="@color/kiro_text"
        android:textSize="64sp" />

    <com.kiroos.recorder.WaveformView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Space
            android:layout_width="64dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/btn_record"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/record"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/pause"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_pause"
            android:visibility="invisible" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/kiro_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_recordings"
            android:visibility="gone"
            style="@style/Kiro.Caption" />
    </FrameLayout>
</LinearLayout>
