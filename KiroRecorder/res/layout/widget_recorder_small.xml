<?xml version="1.0" encoding="utf-8"?>
<!-- Recorder widget, small (2 x 2, Beta 5): one big button; while recording it stops, and the
     card turns red with the time running -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rec_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_recorder_bg"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/rec_main"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/widget_recorder_record_bg"
        android:contentDescription="@string/record"
        android:scaleType="center"
        android:src="@drawable/widget_rec_dot" />

    <TextView
        android:id="@+id/rec_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:singleLine="true"
        android:text="@string/record"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <Chronometer
        android:id="@+id/rec_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
