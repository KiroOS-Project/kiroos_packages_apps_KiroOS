<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp"
        android:paddingEnd="@dimen/kiro_gutter"
        android:paddingStart="@dimen/kiro_gutter">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="@string/app_name"
            style="@style/Kiro.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/wallpapers"
            style="@style/Kiro.Caption" />

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lock_screen"
            style="@style/Kiro.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/kiro_card"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/lock_frame"
                android:layout_width="180dp"
                android:layout_height="320dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/tile_bg">

                <ImageView
                    android:id="@+id/lock_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="40dp"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#66000000"
                    android:shadowRadius="6"
                    android:text="@string/preview_time"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/blur"
                style="@style/Kiro.Body" />

            <SeekBar
                android:id="@+id/blur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/blur_note"
                style="@style/Kiro.Caption" />

            <Button
                android:id="@+id/apply_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/apply_lock"
                style="@style/Kiro.Button.Accent" />

            <Button
                android:id="@+id/reset_lock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/reset_lock"
                style="@style/Kiro.Button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
