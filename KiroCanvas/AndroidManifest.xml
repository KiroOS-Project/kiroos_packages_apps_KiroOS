<?xml version="1.0" encoding="utf-8"?>
<!-- Canvas 1.0 (KiroOS Beta 3): wallpapers and the lock screen blur. It replaces WallpaperPicker:
     the KiroOS wallpapers are drawn by the app at the phone's own resolution (nothing to
     download, no weight in the APK), any picture can come from the gallery, and the lock screen
     can get a blurred copy of the home wallpaper. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kiroos.canvas"
    android:versionCode="101"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_canvas"
        android:theme="@style/Theme.Kiro"
        android:supportsRtl="true">

        <activity
            android:name=".CanvasActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="nosensor">
            <!-- Beta 4.1: no icon in the app list; Canvas opens from the home (hold an empty
                 spot > Wallpaper) and from Settings > Display > Wallpaper -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
