<?xml version="1.0" encoding="utf-8"?>
<!-- filter / tab chip: accent when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kiro_accent" />
            <corners android:radius="@dimen/kiro_corner_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kiro_surface_raised" />
            <corners android:radius="@dimen/kiro_corner_small" />
        </shape>
    </item>
</selector>
