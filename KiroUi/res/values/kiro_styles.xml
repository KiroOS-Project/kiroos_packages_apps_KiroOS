<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS v1.0 theme shared by the suite -->
<resources>

    <style name="Theme.Kiro" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kiro_black</item>
        <item name="android:colorBackground">@color/kiro_black</item>
        <item name="android:statusBarColor">@color/kiro_black</item>
        <item name="android:navigationBarColor">@color/kiro_black</item>
        <item name="android:colorPrimary">@color/kiro_black</item>
        <item name="android:colorPrimaryDark">@color/kiro_black</item>
        <item name="android:colorAccent">@color/kiro_accent</item>
        <item name="android:colorControlHighlight">@color/kiro_ripple</item>
        <item name="android:textColorPrimary">@color/kiro_text</item>
        <item name="android:textColorSecondary">@color/kiro_text_secondary</item>
        <item name="android:textColorHint">@color/kiro_text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Kiro.Dialog</item>
    </style>

    <style name="Theme.Kiro.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/kiro_accent</item>
        <item name="android:windowBackground">@drawable/kiro_dialog_bg</item>
        <item name="android:textColorPrimary">@color/kiro_text</item>
    </style>

    <!-- root of the Kiro.* text and widget styles -->
    <style name="Kiro" />

    <style name="Kiro.Title">
        <item name="android:textSize">@dimen/kiro_title_size</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Kiro.Headline">
        <item name="android:textSize">@dimen/kiro_headline_size</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Kiro.Body">
        <item name="android:textSize">@dimen/kiro_body_size</item>
        <item name="android:textColor">@color/kiro_text</item>
    </style>

    <style name="Kiro.Caption">
        <item name="android:textSize">@dimen/kiro_caption_size</item>
        <item name="android:textColor">@color/kiro_text_secondary</item>
    </style>

    <style name="Kiro.Button">
        <item name="android:background">@drawable/kiro_button</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:textSize">@dimen/kiro_body_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/kiro_touch_target</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Kiro.Button.Accent">
        <item name="android:background">@drawable/kiro_button_accent</item>
        <item name="android:textColor">@color/kiro_on_accent</item>
    </style>

    <style name="Kiro.Field">
        <item name="android:background">@drawable/kiro_field</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:textColorHint">@color/kiro_text_tertiary</item>
        <item name="android:textSize">@dimen/kiro_body_size</item>
        <item name="android:minHeight">@dimen/kiro_touch_target</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

</resources>
