<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="preview_top">64dp</dimen>

    <style name="ToggleChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/kiro_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ModeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/kiro_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.Kiro.Camera" parent="@style/Theme.Kiro">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/kiro_black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
