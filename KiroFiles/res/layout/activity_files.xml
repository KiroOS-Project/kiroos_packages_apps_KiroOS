<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/back"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_back"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/Kiro.Headline" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:maxLines="1"
                android:visibility="gone"
                style="@style/Kiro.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/search"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/more"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- 1.2: search by name -->
    <EditText
        android:id="@+id/search_field"
        style="@style/Kiro.Field"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:singleLine="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="16dp"
                android:paddingStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kiro_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/internal_storage"
                        style="@style/Kiro.Body" />

                    <ProgressBar
                        android:id="@+id/storage_bar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="12dp"
                        android:progressDrawable="@drawable/storage_progress"
                        style="@android:style/Widget.Material.ProgressBar.Horizontal" />

                    <TextView
                        android:id="@+id/storage_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Kiro.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/cat_downloads" layout="@layout/item_tile" />

                    <include android:id="@+id/cat_images" layout="@layout/item_tile" />

                    <include android:id="@+id/cat_videos" layout="@layout/item_tile" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/cat_audio" layout="@layout/item_tile" />

                    <include android:id="@+id/cat_documents" layout="@layout/item_tile" />

                    <include android:id="@+id/cat_apk" layout="@layout/item_tile" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/locations"
                    android:textColor="@color/kiro_accent"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/loc_internal"
                    android:drawableStart="@drawable/ic_storage"
                    android:text="@string/internal_storage"
                    style="@style/LocationRow" />

                <TextView
                    android:id="@+id/loc_sd"
                    android:drawableStart="@drawable/ic_storage"
                    android:text="@string/sd_card"
                    style="@style/LocationRow" />

                <TextView
                    android:id="@+id/loc_root"
                    android:drawableStart="@drawable/ic_lock"
                    android:text="@string/root_folder"
                    style="@style/LocationRow" />
            </LinearLayout>
        </ScrollView>

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:fastScrollEnabled="true"
            android:paddingBottom="88dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            style="@style/Kiro.Caption" />

        <ImageButton
            android:id="@+id/btn_new_folder"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/new_folder"
            android:elevation="6dp"
            android:tint="@color/kiro_on_accent"
            android:src="@drawable/ic_new_folder"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/paste_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kiro_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/paste_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Kiro.Body" />

        <TextView
            android:id="@+id/paste_cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:gravity="center"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:text="@android:string/cancel"
            android:textColor="@color/kiro_text_secondary" />

        <TextView
            android:id="@+id/paste_go"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:gravity="center"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:text="@string/paste"
            android:textColor="@color/kiro_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kiro_surface"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton android:id="@+id/act_copy" android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/copy" style="@style/BarButton" />

        <ImageButton android:id="@+id/act_cut" android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_cut"
            android:contentDescription="@string/cut" style="@style/BarButton" />

        <ImageButton android:id="@+id/act_share" android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_share"
            android:contentDescription="@string/share" style="@style/BarButton" />

        <ImageButton android:id="@+id/act_delete" android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete" style="@style/BarButton" />

        <ImageButton android:id="@+id/act_more" android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/more" style="@style/BarButton" />
    </LinearLayout>
</LinearLayout>
