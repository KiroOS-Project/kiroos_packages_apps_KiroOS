<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FilesWidgetShortcut">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="FilesWidgetIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/widget_files_icon_bg</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/kiro_accent</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="FilesWidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
