<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="selected_row">#2E3987E5</color>

    <style name="LocationRow" parent="@style/Kiro.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">20dp</item>
        <item name="android:drawableTint">@color/kiro_text_secondary</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:background">@drawable/kiro_row</item>
    </style>

    <style name="BarButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/kiro_icon_button</item>
    </style>
</resources>
