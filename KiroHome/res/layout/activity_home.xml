<?xml version="1.0" encoding="utf-8"?>
<!-- Kiro Home: clock, widgets, favourites grid and dock (just the icons, no bar behind them); the drawer slides over them -->
<com.kiroos.home.HomeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/home_margin"
        android:paddingEnd="@dimen/home_margin">

        <!-- the home pages, swiped sideways, from the top of the screen to the dots; the
             first page's header (clock and widgets) lies over its top and slides away with
             it, the other pages use the whole height -->
        <FrameLayout
            android:id="@+id/pages_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- negative margins: the pages slide edge to edge across the whole screen, the
                 padding keeps the cells where the home margin puts them -->
            <com.kiroos.home.Workspace
                android:id="@+id/workspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/home_margin_neg"
                android:layout_marginStart="@dimen/home_margin_neg"
                android:paddingEnd="@dimen/home_margin"
                android:paddingStart="@dimen/home_margin" />

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Beta 4.1: the clock is a widget of the grid (layout/home_clock.xml) -->
                <LinearLayout
                    android:id="@+id/widget_stack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>

        <com.kiroos.home.PageIndicator
            android:id="@+id/page_indicator"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:paddingTop="10dp" />
    </LinearLayout>

    <!-- where a dragged app will land -->
    <View
        android:id="@+id/drop_hint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/drop_hint"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/drawer_scrim"
        android:clickable="true"
        android:visibility="invisible">

        <LinearLayout
            android:id="@+id/drawer_inner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.kiroos.home.SearchField
                android:id="@+id/drawer_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/home_margin"
                android:layout_marginStart="@dimen/home_margin"
                android:layout_marginTop="16dp"
                android:drawablePadding="12dp"
                android:drawableStart="@drawable/ic_search"
                android:hint="@string/search_apps"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1"
                android:singleLine="true"
                style="@style/Kiro.Field" />

            <GridView
                android:id="@+id/drawer_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:listSelector="@android:color/transparent"
                android:numColumns="4"
                android:overScrollMode="ifContentScrolls"
                android:paddingBottom="24dp"
                android:paddingEnd="@dimen/home_margin"
                android:paddingStart="@dimen/home_margin"
                android:paddingTop="12dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="none"
                android:fastScrollEnabled="true"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/menu_anchor"
        android:layout_width="1dp"
        android:layout_height="1dp" />

</com.kiroos.home.HomeLayout>
