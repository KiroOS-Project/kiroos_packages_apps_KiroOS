<?xml version="1.0" encoding="utf-8"?>
<!-- kAI over the current app (hold Power): a dim, the kAI aura rising from the bottom of the
     screen, and the card. Tapping the dim closes it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kai_overlay_dim" />

    <com.kiroos.kai.KaiAuraView
        android:id="@+id/aura"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingBottom="14dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp">

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/kai_overlay_card"
            android:clickable="true"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingEnd="10dp"
            android:paddingStart="18dp"
            android:paddingTop="12dp">

            <view
                class="com.kiroos.kai.KaiOverlayActivity$AnswerScroll"
                android:id="@+id/scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp">

                    <TextView
                        android:id="@+id/question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textIsSelectable="true"
                        android:textSize="16sp" />
                </LinearLayout>
            </view>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/sparkle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/kiro_accent" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <EditText
                        android:id="@+id/input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/ask"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:inputType="textCapSentences"
                        android:maxLines="3"
                        android:paddingBottom="10dp"
                        android:paddingTop="10dp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="17sp" />

                    <!-- while kAI listens: the voice as a wave, and what it is doing -->
                    <LinearLayout
                        android:id="@+id/voice_row"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.kiroos.kai.KaiWaveView
                            android:id="@+id/wave"
                            android:layout_width="84dp"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/voice_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/kiro_icon_button"
                    android:contentDescription="@string/voice"
                    android:src="@drawable/ic_mic"
                    android:tint="?android:attr/textColorPrimary" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/send"
                    android:src="@drawable/ic_send"
                    android:tint="@color/kiro_on_accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/open_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/kiro_icon_button"
                    android:gravity="center"
                    android:paddingEnd="8dp"
                    android:paddingStart="8dp"
                    android:text="@string/open_chat"
                    android:textColor="@color/kiro_accent"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
