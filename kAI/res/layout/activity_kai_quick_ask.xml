<?xml version="1.0" encoding="utf-8"?>
<!-- Typing on the home: the kAI bar widget becomes a text field in its own place
     (KaiQuickAskActivity moves the pill onto the widget's bounds) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D000000">

    <LinearLayout
        android:id="@+id/quick_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/widget_kai_bar_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp"
        android:paddingStart="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkle"
            android:tint="@color/kiro_accent" />

        <EditText
            android:id="@+id/quick_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/widget_kai_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences|textAutoCorrect"
            android:singleLine="true"
            android:textColor="@color/kiro_text"
            android:textColorHint="@color/kiro_text_secondary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/quick_send"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/send"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            android:tint="@color/kiro_on_accent" />
    </LinearLayout>
</FrameLayout>
