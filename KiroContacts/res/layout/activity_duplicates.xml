<?xml version="1.0" encoding="utf-8"?>
<!-- Kiro Contacts 1.2: duplicates -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:tint="?android:attr/textColorPrimary" />

        <TextView
            style="@style/Kiro.Headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/duplicates" />

        <Button
            android:id="@+id/btn_merge_all"
            style="@style/Kiro.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="40dp"
            android:text="@string/merge_all"
            android:textColor="@color/kiro_accent"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        style="@style/Kiro.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/duplicates_summary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingBottom="16dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp" />

        <TextView
            android:id="@+id/empty"
            style="@style/Kiro.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_duplicates"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
