<?xml version="1.0" encoding="utf-8"?>
<!-- one app: icon, name, what it does, badge, Get / Open -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="80dp"
    android:orientation="horizontal"
    android:paddingEnd="20dp"
    android:paddingStart="20dp">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Kiro.Title" />

        <TextView
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/Kiro.Caption" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/kiro_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/kiro_button_accent"
        android:gravity="center"
        android:minWidth="76dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:textColor="@color/kiro_on_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
