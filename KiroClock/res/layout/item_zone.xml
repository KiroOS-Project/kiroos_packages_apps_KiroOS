<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/kiro_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="20dp"
    android:paddingStart="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/zone_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Kiro.Body" />

        <TextView
            android:id="@+id/zone_offset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Kiro.Caption" />
    </LinearLayout>

    <TextClock
        android:id="@+id/zone_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm a"
        android:format24Hour="HH:mm"
        android:textColor="@color/kiro_text"
        android:textSize="32sp" />
</LinearLayout>
