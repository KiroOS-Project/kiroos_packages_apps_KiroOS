<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- one of the seven day circles in the alarm editor -->
    <style name="DayToggle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/day_toggle</item>
        <item name="android:textColor">@color/kiro_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
