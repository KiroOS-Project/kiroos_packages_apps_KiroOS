<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:text="@string/app_name"
        style="@style/Kiro.Title" />

    <EditText
        android:id="@+id/search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_search"
        android:drawableTint="@color/kiro_text_secondary"
        android:hint="@string/search"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true"
        style="@style/Kiro.Field" />

    <TextView
        android:id="@+id/default_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/kiro_button"
        android:padding="16dp"
        android:text="@string/make_default"
        android:visibility="gone"
        style="@style/Kiro.Body" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingBottom="88dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_conversations"
            android:visibility="gone"
            style="@style/Kiro.Caption" />

        <ImageButton
            android:id="@+id/btn_new"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/new_message"
            android:elevation="6dp"
            android:tint="?android:attr/textColorPrimary"
            android:src="@drawable/ic_add" />
    </FrameLayout>
</LinearLayout>
