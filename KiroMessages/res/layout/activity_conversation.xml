<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                style="@style/Kiro.Headline" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                style="@style/Kiro.Caption" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_call"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/call"
            android:src="@drawable/ic_call" />
    </LinearLayout>

    <MultiAutoCompleteTextView
        android:id="@+id/recipients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        android:completionThreshold="1"
        android:dropDownVerticalOffset="4dp"
        android:hint="@string/to_hint"
        android:imeOptions="actionNext|flagNoExtractUi"
        android:inputType="textPersonName|textNoSuggestions"
        android:popupBackground="@drawable/kiro_dialog_bg"
        android:visibility="gone"
        style="@style/Kiro.Field" />

    <ListView
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingBottom="8dp"
        android:paddingTop="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <FrameLayout
        android:id="@+id/attachment"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginStart="64dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/attachment_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageButton
            android:id="@+id/attachment_remove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/kiro_circle"
            android:contentDescription="@string/remove_attachment"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btn_attach"
            android:layout_width="@dimen/kiro_touch_target"
            android:layout_height="@dimen/kiro_touch_target"
            android:background="@drawable/kiro_icon_button"
            android:contentDescription="@string/attach"
            android:src="@drawable/ic_image"
            android:tint="@color/kiro_text_secondary" />

        <EditText
            android:id="@+id/compose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:hint="@string/compose_hint"
            android:imeOptions="flagNoExtractUi"
            android:inputType="textMultiLine|textCapSentences|textShortMessage|textAutoCorrect"
            android:maxLines="5"
            android:paddingBottom="12dp"
            android:paddingTop="12dp"
            style="@style/Kiro.Field" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textSize="11sp"
                android:visibility="gone"
                style="@style/Kiro.Caption" />

            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="@dimen/kiro_touch_target"
                android:layout_height="@dimen/kiro_touch_target"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
