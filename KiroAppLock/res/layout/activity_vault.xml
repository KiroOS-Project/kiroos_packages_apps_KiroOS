<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kiro_black"
    android:fitsSystemWindows="true">

    <!-- the fingerprint first -->
    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingEnd="@dimen/kiro_gutter"
        android:paddingStart="@dimen/kiro_gutter">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_launcher_vault" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/vault_title"
            style="@style/Kiro.Headline" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/auth_panel" />

        <View
            android:layout_width="match_parent"
            android:layout_height="64dp" />
    </LinearLayout>

    <!-- the vault -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/kiro_gutter"
            android:paddingStart="@dimen/kiro_gutter"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vault_title"
                style="@style/Kiro.Title" />

            <Button
                android:id="@+id/add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_add"
                style="@style/Kiro.Button.Accent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingEnd="@dimen/kiro_gutter"
            android:paddingStart="@dimen/kiro_gutter"
            android:text="@string/vault_explain"
            style="@style/Kiro.Caption" />

        <TextView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingEnd="@dimen/kiro_gutter"
            android:paddingStart="@dimen/kiro_gutter"
            android:textColor="@color/kiro_accent"
            android:visibility="gone"
            style="@style/Kiro.Caption" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <GridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:horizontalSpacing="3dp"
                android:numColumns="3"
                android:paddingEnd="3dp"
                android:paddingStart="3dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="3dp" />

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/vault_empty"
                android:visibility="gone"
                style="@style/Kiro.Body" />
        </FrameLayout>
    </LinearLayout>

    <!-- one photo or video -->
    <FrameLayout
        android:id="@+id/viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <VideoView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/viewer_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/kiro_icon_button"
                android:contentDescription="@android:string/cancel"
                android:src="@drawable/ic_close_white" />

            <TextView
                android:id="@+id/viewer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/viewer_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_save_copy"
                style="@style/Kiro.Button.Accent" />

            <Button
                android:id="@+id/viewer_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/vault_delete"
                style="@style/Kiro.Button" />
        </LinearLayout>
    </FrameLayout>

    <!-- no screen lock: nothing to lock with -->
    <LinearLayout
        android:id="@+id/nolock_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/vault_need_screen_lock"
            style="@style/Kiro.Body" />

        <Button
            android:id="@+id/set_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_screen_lock"
            style="@style/Kiro.Button.Accent" />
    </LinearLayout>

    <!-- the key was erased with the screen lock -->
    <LinearLayout
        android:id="@+id/lost_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/vault_lost"
            style="@style/Kiro.Body" />

        <Button
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/vault_reset"
            style="@style/Kiro.Button" />
    </LinearLayout>
</FrameLayout>