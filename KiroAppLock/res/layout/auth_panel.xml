<?xml version="1.0" encoding="utf-8"?>
<!-- the fingerprint glyph, the status line and the screen lock button (Auth.java) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/fingerprint"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/kiro_circle"
        android:padding="16dp"
        android:src="@drawable/ic_fingerprint" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/touch_sensor"
        style="@style/Kiro.Caption" />

    <Button
        android:id="@+id/use_lock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:text="@string/use_lock"
        style="@style/Kiro.Button" />
</merge>
