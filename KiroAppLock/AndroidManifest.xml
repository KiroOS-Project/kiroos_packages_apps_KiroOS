<?xml version="1.0" encoding="utf-8"?>
<!-- Kiro App Lock 1.0 (KiroOS Beta 3): apps that open only after the fingerprint (or the screen
     lock), enforced by the activity manager (frameworks/base ActivityStartInterceptor). It has no
     app icon: an app is locked from the home screen (long-press, "Lock app"), and the list and
     the private vault are in Settings > Security. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kiroos.applock"
    android:versionCode="101"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="25" android:targetSdkVersion="25" />

    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- the locked list lives in Settings.Secure, where the activity manager reads it -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- a locked app opened from Recents is reopened as its task -->
    <uses-permission android:name="android.permission.START_TASKS_FROM_RECENTS" />

    <!-- held by Kiro Home: lock or unlock one app from its long-press menu -->
    <permission
        android:name="com.kiroos.applock.permission.LOCK_APPS"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_applock"
        android:theme="@style/Theme.Kiro"
        android:supportsRtl="true">

        <!-- the locked apps list, from Settings > Security > App lock -->
        <activity
            android:name=".AppLockActivity"
            android:label="@string/app_name"
            android:screenOrientation="nosensor"
            android:exported="true">
            <intent-filter>
                <action android:name="com.kiroos.applock.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- one app, from the home screen's long-press menu: com.kiroos.applock.action.LOCK_APP
             or UNLOCK_APP with EXTRA_PACKAGE_NAME; unlocking asks for the fingerprint first -->
        <activity
            android:name=".LockAppActivity"
            android:label="@string/app_name"
            android:permission="com.kiroos.applock.permission.LOCK_APPS"
            android:excludeFromRecents="true"
            android:taskAffinity="com.kiroos.applock.toggle"
            android:screenOrientation="nosensor"
            android:exported="true" />

        <!-- the private vault: opened from Settings > Security or App Lock, or as a share target
             ("Private vault" in any app's share sheet); it asks for the fingerprint itself, an
             intent can't skip it -->
        <activity
            android:name=".VaultActivity"
            android:label="@string/vault_title"
            android:icon="@drawable/ic_launcher_vault"
            android:launchMode="singleTask"
            android:taskAffinity="com.kiroos.applock.vault"
            android:screenOrientation="nosensor"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>

        <!-- started only by the activity manager (system uid): no other app can show it -->
        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.kiroos.applock.unlock"
            android:screenOrientation="nosensor"
            android:permission="android.permission.MANAGE_ACTIVITY_STACKS"
            android:exported="true" />
    </application>
</manifest>
